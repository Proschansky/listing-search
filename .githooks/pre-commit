#!/usr/bin/env bash
# Pre-commit: lint, type-check and test the half (or halves) of the monorepo
# that this commit touches. Fast enough to run on every commit; the full
# suite, e2e included, runs on push.
#
# Skip in an emergency with `git commit --no-verify` - CI still runs every
# check, so a skipped hook can't sneak a failure into main.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

run() { printf '\n\033[1m==> %s\033[0m\n' "$*"; make --no-print-directory "$@"; }

# Shared files (Makefile, hooks, CI config) can affect both halves.
shared=$(echo "$staged" | grep -Ev '^(frontend|backend)/' || true)

if echo "$staged" | grep -q '^backend/' || [ -n "$shared" ]; then
  run lint-backend
  run test-backend
fi
if echo "$staged" | grep -q '^frontend/' || [ -n "$shared" ]; then
  run lint-frontend
  run test-frontend
fi

printf '\n\033[32mpre-commit checks passed\033[0m\n'
