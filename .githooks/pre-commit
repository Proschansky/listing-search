#!/usr/bin/env bash
# Pre-commit: the fast checks only. Lint, formatting and type checks for the
# half (or halves) of the monorepo this commit touches, which takes seconds.
#
# Tests run once, at push time (.githooks/pre-push), not on every commit.
# Running them here as well meant every commit-then-push tested the same code
# twice, and the slow part of the gate is the tests, not the linters.
#
# Skip in an emergency with `git commit --no-verify`. The pre-push hook and CI
# still run every check, so a skipped hook can't sneak a failure into main.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

# Documentation only (Markdown files, anything under docs/): there's nothing
# for the linters to check, so don't make you wait for them.
if ! grep -qvE '(\.md$|^docs/)' <<<"$staged"; then
  printf '\033[32mpre-commit: only documentation changed; nothing to lint.\033[0m\n'
  exit 0
fi

run() { printf '\n\033[1m==> %s\033[0m\n' "$*"; make --no-print-directory "$@"; }

# Shared files (Makefile, hooks, CI config, scripts) can affect both halves.
shared=$(echo "$staged" | grep -Ev '^(frontend|backend)/' || true)

if echo "$staged" | grep -q '^backend/' || [ -n "$shared" ]; then
  run lint-backend
fi
if echo "$staged" | grep -q '^frontend/' || [ -n "$shared" ]; then
  run lint-frontend
fi

printf '\n\033[32mpre-commit checks passed\033[0m (tests run on push)\n'
