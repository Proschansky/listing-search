{
  // Type-checking for the Playwright suite (e2e/) and its config. Separate
  // from the app's tsconfig because these files run in Node but also contain
  // callbacks that run in the browser (page.evaluate), so they need both
  // Node and DOM types.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // e2e/fixtures.ts imports the evidence helpers, which are plain .mjs so
    // Node can run the pr:evidence script without a build step. checkJs
    // type-checks them through their JSDoc annotations.
    "allowJs": true,
    "checkJs": true
  },
  "include": ["playwright.config.ts", "e2e/**/*.ts", "scripts/**/*.mjs"],
  // The scripts' unit tests use loosely shaped fakes on purpose; the code
  // they test is type-checked.
  "exclude": ["scripts/**/*.test.mjs"]
}
