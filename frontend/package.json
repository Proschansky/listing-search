{
  "name": "listing-search-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "test": "vitest run",
    "test:a11y": "vitest run src/a11y.test.tsx",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pr:evidence": "node scripts/pr-evidence.mjs",
    "pr:evidence:publish": "node scripts/pr-evidence.mjs --publish",
    "pr:create": "node scripts/pr-evidence.mjs --create"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.1",
    "axe-core": "^4.14.1",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
